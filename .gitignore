# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins-dependencies
app/build/
app/.idea/
app/android/.gradle/
app/android/local.properties
app/ios/Pods/
app/ios/.symlinks/
app/windows/flutter/ephemeral/
app/linux/flutter/ephemeral/
app/macos/Flutter/ephemeral/
*.iml

# Les rendus de reference sont versionnes (test/goldens/) : ils servent de
# preuve visuelle et de garde-fou contre les regressions.
# Les echecs de comparaison, eux, ne le sont pas.
app/test/failures/

# Node / API (etape suivante)
api/node_modules/
api/.wrangler/
api/dist/

# Secrets - rien de tout cela ne doit entrer dans l historique
.env
.env.*
!.env.example
.dev.vars
*.jks
*.keystore
# Cle de debug partagee CI/dev (sans valeur de securite) : versionnee.
!app/android/app/debug.keystore
**/google-services.json
**/GoogleService-Info.plist

# OS
.DS_Store
Thumbs.db
.gstack/

# Etat local de l agent : jonctions Windows vers .agents/skills/, arbres de
# travail temporaires, reglages propres a la machine. Rien la-dedans ne
# decrit le produit, et le dossier pese 36 Mo.
.claude/
.neon
node_modules/

# Jeux d'icones exportes par un generateur externe : seules les sources
# retenues comptent, dans app/branding/ (voir pubspec flutter_launcher_icons).
/icon_mobile/
/android/
/apple-devices/

# Reglages d'editeur propres a une machine (chemins absolus).
.vscode/

# Notes de travail personnelles : options non retenues, pistes de mise a jour.
# Hors du depot public — ce n'est pas au jury de lire le carnet de bord.
/prive/

# Rushes et montage de la video de soumission : 119 Mo qui n'apprennent rien
# a qui lit le code. La video finie vit sur YouTube.
app/branding/videos/

# Script de narration : un document de travail personnel, cale au montage
# d'une prise precise. Il ne decrit pas le produit.
app/devpost/voiceover.md

# Documentation tierce (Clerk, Neon) recopiee pour outiller le poste de
# travail : 163 fichiers que rien dans le projet ne lit, et qui ne sont pas
# a nous pour etre redistribues sous notre licence.
.agents/
skills-lock.json
