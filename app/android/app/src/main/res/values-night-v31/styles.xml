<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ en mode sombre. Le fond du lancement reste le bleu de la
     marque : l'icone ne change pas avec le theme, l'ecran de lancement non
     plus. Copie conforme de `values-v31`, au parent pres. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ly_navy</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
