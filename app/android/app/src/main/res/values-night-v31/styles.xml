<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ en mode sombre. Le fond du splash reste le bleu de la
     marque : l'icone ne change pas avec le theme, l'ecran de lancement non
     plus. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ly_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
