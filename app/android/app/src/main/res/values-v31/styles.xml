<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : l'ecran de lancement est gere par le systeme, qui pose
     l'icone du lanceur au centre du fond declare ici. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ly_navy</item>
        <!-- Ce que le systeme affiche une fois son ecran de lancement retire,
             en attendant la premiere frame Flutter. Sans cette ligne, la
             fenetre prenait le fond du theme parent — BLANC — et le
             lancement restait blanc pendant tout le demarrage du moteur.
             `windowSplashScreenBackground` ne couvre que l ecran systeme
             lui-meme, pas ce qui suit : les deux sont necessaires. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Le theme que Flutter applique dans `onCreate`. Meme fond, pour
             que le changement de theme ne se voie pas. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
