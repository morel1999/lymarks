<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : l'ecran de lancement est gere par le systeme, qui pose
     l'icone du lanceur au centre du fond declare ici. Rien a dessiner
     nous-memes, et la mascotte apparait donc des le premier pixel. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ly_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Le relais de l ecran de lancement. Par defaut c est le fond du
             theme, donc BLANC en clair : entre la disparition du splash
             systeme et la premiere frame Flutter, l ouverture clignotait en
             blanc. Le bleu nuit prolonge le splash jusqu a la mascotte. -->
        <item name="android:windowBackground">@color/ly_navy</item>
    </style>
</resources>
