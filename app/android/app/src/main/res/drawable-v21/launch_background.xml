<?xml version="1.0" encoding="utf-8"?>
<!-- Android 21 a 30 : cette variante prime sur `drawable/`. Meme fond bleu
     nuit et meme mascotte, sans quoi le lancement repasserait au blanc du
     systeme sur toute cette plage de versions. Sur 12+, values-v31 prend le
     relais et c'est le systeme qui centre l'icone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ly_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mascot" />
    </item>
</layer-list>
