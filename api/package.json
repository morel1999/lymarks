{
  "name": "lymarks-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Lymarks — Hono sur Cloudflare Workers, Neon + pgvector",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint src test scripts",
    "format": "prettier --write \"{src,test,scripts,migrations}/**/*.{ts,sql}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "hono": "^4.9.0",
    "jose": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.30.0"
  },
  "engines": {
    "node": ">=22"
  }
}
